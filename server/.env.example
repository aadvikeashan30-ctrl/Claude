# ============================================================================
# AI Employee Monitoring Server — environment configuration
# Copy this file to .env and fill in real values, then `npm start`
# ============================================================================

# --- Server ---
PORT=3001
COMPANY_NAME=Your Company

# Expected daily login time (24h format). Used to flag late logins.
EXPECTED_LOGIN_HOUR=9
EXPECTED_LOGIN_MINUTE=0

# --- Email (Gmail SMTP) ---
# 1. Use a Gmail account you own
# 2. Enable 2-Step Verification on that account
# 3. Generate an App Password: https://myaccount.google.com/apppasswords
#    (pick "Mail" → "Other" → name it "Monitoring Server")
# 4. Paste the 16-char app password below (no spaces)
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where the hourly digest is sent
RECIPIENT_EMAIL=aicodeorigin@gmail.com

# How often the digest goes out, in minutes (default: 60 = hourly)
EMAIL_INTERVAL_MINUTES=60

# Send a per-session email when an employee logs out (true/false)
EMAIL_ON_SESSION_END=true

# --- CORS ---
# Allowed origins for the browser tracker, comma-separated.
# Use * to allow all (fine for development; restrict in production).
CORS_ORIGIN=*
